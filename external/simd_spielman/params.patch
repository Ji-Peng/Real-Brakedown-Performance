+inline uint32_t configuredSliceCount(uint32_t default_count, uint32_t log_n) {
+  const char* single = std::getenv("SIMD_SPIELMAN_SLICES");
+  if (single != nullptr && *single != '\0') {
+    char* end = nullptr;
+    errno = 0;
+    unsigned long value = std::strtoul(single, &end, 10);
+    if (errno != 0 || end == single || *end != '\0' || value == 0 || (BRAKEDOWN && value > column_size_AVX512)) {
+      std::fprintf(stderr, "Invalid SIMD_SPIELMAN_SLICES value: %s\n", single);
+      std::exit(EXIT_FAILURE);
+    }
+    return static_cast<uint32_t>(BRAKEDOWN || value < column_size_AVX512 ? value : column_size_AVX512);
+  }
+
+  const char* table = std::getenv("SIMD_SPIELMAN_SLICE_TABLE");
+  if (table != nullptr && *table != '\0') {
+    char* copy = ::strdup(table);
+    if (copy == nullptr) {
+      std::perror("strdup");
+      std::exit(EXIT_FAILURE);
+    }
+    bool found = false;
+    uint32_t value = default_count;
+    for (char* entry = std::strtok(copy, ","); entry != nullptr; entry = std::strtok(nullptr, ",")) {
+      char* separator = std::strchr(entry, ':');
+      if (separator == nullptr) {
+        std::fprintf(stderr, "Invalid SIMD_SPIELMAN_SLICE_TABLE entry: %s\n", entry);
+        std::free(copy);
+        std::exit(EXIT_FAILURE);
+      }
+      *separator = '\0';
+      char* log_end = nullptr;
+      char* slice_end = nullptr;
+      errno = 0;
+      unsigned long entry_log_n = std::strtoul(entry, &log_end, 10);
+      unsigned long entry_slices = std::strtoul(separator + 1, &slice_end, 10);
+      if (errno != 0 || log_end == entry || *log_end != '\0' || slice_end == separator + 1 || *slice_end != '\0' || entry_slices == 0) {
+        std::fprintf(stderr, "Invalid SIMD_SPIELMAN_SLICE_TABLE entry: %s\n", entry);
+        std::free(copy);
+        std::exit(EXIT_FAILURE);
+      }
+      if (entry_log_n == log_n) {
+        if (BRAKEDOWN && entry_slices > column_size_AVX512) {
+          std::fprintf(stderr, "SIMD-Spielman slice count exceeds the Brakedown row count for logN=%u\n", log_n);
+          std::free(copy);
+          std::exit(EXIT_FAILURE);
+        }
+        value = static_cast<uint32_t>(BRAKEDOWN || entry_slices < column_size_AVX512 ? entry_slices : column_size_AVX512);
+        found = true;
+      }
+    }
+    std::free(copy);
+    if (found) {
+      return value;
+    }
+  }
+
+  if (default_count == 0) {
+    std::fprintf(stderr, "No default slice-table entry for SELECTED_CPU and logN=%u; set SIMD_SPIELMAN_SLICES or SIMD_SPIELMAN_SLICE_TABLE\n", log_n);
+    std::exit(EXIT_FAILURE);
+  }
+  return default_count;
+}
